{
  "version": 2,
  "routes": [
    { "src": "/api/(?:learning|preview-learning)/?", "status": 410 },
    { "src": "/src/server(?:/.*)?", "status": 404 },
    { "src": "/(?:ai-lab|benchmarks|tools|tests|docs)(?:/.*)?", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "functions": { "api/mindling/reason.js": { "maxDuration": 60 } }
}
